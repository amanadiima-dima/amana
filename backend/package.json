{
  "name": "amana-backend",
  "version": "1.0.0",
  "description": "Amana API \u2013 peer-to-peer parcel delivery platform",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "make-admin": "node scripts/make-admin.js",
    "start:prod": "DIRECT_URL=${DIRECT_URL:-$DATABASE_URL} prisma migrate deploy && node src/index.js",
    "test:e2e": "node tests/e2e/run-all.js"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "firebase-admin": "^12.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "prisma": "^5.14.0",
    "socket.io": "^4.7.5",
    "stripe": "^15.12.0",
    "twilio": "^5.1.1",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  }
}
