# Environment Variables – Amana Backend
# Copy this to .env and fill in real values.
# For Railway: set all these as environment variables in the Railway dashboard.

# Server
PORT=3000
NODE_ENV=production

# Database (Neon — use pooled URL for app, direct URL for migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/amana?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/amana?sslmode=require"

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# Twilio (OTP)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

# OTP bypass (DEV ONLY — must be false in production!)
OTP_BYPASS=false

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe (payments)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Firebase (push notifications — optional, leave blank to disable)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# Platform fee
PLATFORM_FEE_PERCENT=10

# CORS — set to your Vercel web URL in production
CORS_ORIGIN=https://amana.vercel.app
