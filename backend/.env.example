# Environment Variables – Amana Backend
# Copy this to .env and fill in real values.
# For Railway: set all these as environment variables in the Railway dashboard.

# Server
PORT=3000
NODE_ENV=production

# Database (Neon — use pooled URL for app, direct URL for migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/amana?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/amana?sslmode=require"

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# Twilio (OTP)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid

# OTP bypass (DEV ONLY — must be false in production!)
OTP_BYPASS=false

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe (payments)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Firebase (push notifications — optional, leave blank to disable)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# Platform fee
PLATFORM_FEE_PERCENT=10

# CORS — set to your Vercel web URL in production
CORS_ORIGIN=https://amana.vercel.app

# Public web URL used in invitation links (recipient-pays)
WEB_URL=http://localhost:3001
# WhatsApp + SMS invitations (leave unset to stay in stub mode: messages are only logged/recorded)
# TWILIO_WHATSAPP_FROM=+14155238886
# TWILIO_SMS_FROM=+1...            (or TWILIO_MESSAGING_SERVICE_SID=MG...)
# TWILIO_WHATSAPP_TEMPLATE_SID=HX...  (+ optional _FR/_ES/_AR) — approved template, variables: 1=sender 2=route 3=amount 4=link
# MESSAGING_CHANNELS=whatsapp,sms
# MAX_INVITES_PER_DAY=10

# ── Hosted / beta settings ──
# PAYMENTS_MODE=simulated   (default; no real money). Only set "stripe" once the real-Stripe flow is reworked.
# CORS_ORIGIN=https://your-web-domain   (comma-separated if several)
# WEB_URL=https://your-web-domain       (used in invitation links)
# JWT_SECRET / JWT_REFRESH_SECRET: 32+ random characters each
# NODE_ENV=production
# CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET are REQUIRED when hosted
