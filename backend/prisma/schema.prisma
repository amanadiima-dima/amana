// This is your Prisma schema file for Amana

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  TRAVELER
  SENDER
  ADMIN
  MODERATOR // staff helper: can review ID verifications and disputes, nothing else
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TripStatus {
  OPEN
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TransportMode {
  PLANE
  TRAIN
  BUS
  CAR
  BOAT
}

enum BookingStatus {
  PAYMENT_PENDING // waiting for the recipient (payer) to pay; traveler doesn't see it yet
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
  DISPUTED
}

enum TrackingStatus {
  PENDING
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
}

enum PaymentStatus {
  PENDING
  HELD
  RELEASED
  REFUNDED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  phone             String    @unique
  email             String?   @unique // optional second sign-in identifier (stored lower-case)
  passwordHash      String?   // bcrypt; null for accounts created before passwords existed (they set one via "forgot password")
  name              String    // first name — the only part other members see
  lastName          String?   // asked at sign-up; private (owner + staff, e.g. to match the ID document)
  birthDate         DateTime? @db.Date // asked at sign-up (must be 18+); null for accounts created before 2026-10-22
  photoUrl          String?
  bio               String?
  isVerified        Boolean   @default(false) // ID verified
  isActive          Boolean   @default(true)
  role              UserRole  @default(SENDER)
  fcmToken          String?   // Firebase push token
  stripeAccountId   String?   // Stripe Connect account (for traveler payouts)
  rating            Float     @default(0)
  reviewCount       Int       @default(0)
  termsAcceptedAt   DateTime? // when they accepted the Terms + Privacy Policy and confirmed they are 18+
  // Account closed by the user (GDPR erasure): the profile is anonymised at once; what must be kept for
  // legal claims (ID documents, real name + phone) stays in a restricted archive until `retainUntil`.
  deletedAt         DateTime?
  retainUntil       DateTime?
  archivedName      String?   // real name/phone of a closed account — staff-only, purged at retainUntil
  archivedPhone     String?
  // Legal hold set by an admin (incident, police report…): nothing about this user is purged while set.
  legalHoldAt       DateTime?
  legalHoldNote     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  idVerification    IdVerification?
  tripsAsTraveler   Trip[]
  parcelRequests    ParcelRequest[]
  bookingsAsSender  Booking[]       @relation("SenderBookings")
  bookingsAsPayer   Booking[]       @relation("PayerBookings")
  reviewsGiven      Review[]        @relation("ReviewsGiven")
  reviewsReceived   Review[]        @relation("ReviewsReceived")
  notifications     Notification[]
  messagesSent      Message[]       @relation("MessagesSent")
}

model IdVerification {
  id          String             @id @default(cuid())
  userId      String             @unique
  user        User               @relation(fields: [userId], references: [id])
  documentType String            @default("ID_CARD") // ID_CARD | PASSPORT
  frontPhoto  String             // private upload reference (front, or the passport photo page)
  backPhoto   String?            // not needed for passports
  selfieVideo String?            // short video of the user holding the document next to their face
  challengeCode String?          // random code the user had to say aloud in the video (checked by the reviewer)
  consentAt   DateTime?          // explicit consent to process ID + biometric video
  provider    String?            // external verification provider, if one handled it
  providerRef String?            // provider's session/check id
  status      VerificationStatus @default(PENDING)
  reviewNote  String?            // Admin note on rejection
  reviewedAt  DateTime?          // when staff approved/rejected it (starts the retention clocks)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

model Trip {
  id             String     @id @default(cuid())
  travelerId     String
  traveler       User       @relation(fields: [travelerId], references: [id])
  originCity     String
  destinationCity String
  originAddress  String?       // pickup place — free-text address
  originLat      Float?        // pickup place — map pin latitude
  originLng      Float?        // pickup place — map pin longitude
  mode           TransportMode @default(PLANE)
  estimatedDurationMinutes Int?  // traveler's estimate of travel time
  departureAt    DateTime
  maxWeightKg    Float      // max carry capacity in kg
  pricePerKg     Float      // price set by traveler, in `currency`
  currency       String     @default("EUR") // ISO 4217; defaults from the departure country
  notes          String?
  status         TripStatus @default(OPEN)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  bookings       Booking[]

  @@index([destinationCity, departureAt])
}

model ParcelRequest {
  id               String   @id @default(cuid())
  senderId         String
  sender           User     @relation(fields: [senderId], references: [id])
  pickupAddress    String
  deliveryAddress  String
  weightKg         Float
  description      String
  estimatedValue   Float?   // declared value, in `valueCurrency`
  valueCurrency    String   @default("EUR")
  fragile          Boolean  @default(false)
  photoUrls        String[] // Cloudinary URLs
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // One parcel can accumulate several booking attempts over its life (e.g. a
  // traveler rejects it, the sender tries a different trip) — only one may be
  // active (PENDING/ACCEPTED/COMPLETED) at a time; enforced in the controller.
  bookings         Booking[]
}

model Booking {
  id              String        @id @default(cuid())
  tripId          String
  trip            Trip          @relation(fields: [tripId], references: [id])
  parcelRequestId String
  parcelRequest   ParcelRequest @relation(fields: [parcelRequestId], references: [id])
  senderId        String
  sender          User          @relation("SenderBookings", fields: [senderId], references: [id])
  // Who pays. Null = the sender. Set when the sender asks the recipient (an Amana user) to pay.
  payerId         String?
  payer           User?         @relation("PayerBookings", fields: [payerId], references: [id])
  payerPhone      String?       // the invited payer's phone (may not have an account yet; linked on login)
  inviteToken     String?       @unique // secret in the invitation link
  payDeadline     DateTime?     // payer must pay before this
  respondDeadline DateTime?     // traveler must answer before this (payment-first flow)
  status          BookingStatus @default(PENDING)
  confirmedAt     DateTime?
  // 6-digit code the sender hands to the recipient; the traveler needs it to confirm delivery.
  deliveryCode    String?
  // Optional extra the sender offers for urgent delivery, in the trip's currency; added to the total.
  priorityTip     Float         @default(0)
  disputeReason   String?
  disputedAt      DateTime?
  disputeOutcome  String?       // 'REFUNDED' | 'RELEASED' once an admin resolves it
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  trackingEvents  TrackingEvent[]
  payment         Payment?
  reviews         Review[]
  messages        Message[]
}

model Message {
  id         String    @id @default(cuid())
  bookingId  String
  booking    Booking   @relation(fields: [bookingId], references: [id])
  senderId   String
  sender     User      @relation("MessagesSent", fields: [senderId], references: [id])
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([bookingId, createdAt])
}

model TrackingEvent {
  id         String         @id @default(cuid())
  bookingId  String
  booking    Booking        @relation(fields: [bookingId], references: [id])
  status     TrackingStatus
  note       String?
  photoUrl   String?        // proof of delivery photo
  createdAt  DateTime       @default(now())

  @@index([bookingId])
}

model Payment {
  id                    String        @id @default(cuid())
  bookingId             String        @unique
  booking               Booking       @relation(fields: [bookingId], references: [id])
  senderId              String
  travelerId            String
  grossAmount           Float         // total charged to sender (incl. fee)
  platformFee           Float         // 10% of baseAmount
  travelerAmount        Float         // amount to release to traveler
  currency              String        @default("EUR")
  stripePaymentIntentId String        @unique
  stripeTransferId      String?       // set when funds released to traveler
  status                PaymentStatus @default(PENDING)
  paidAt                DateTime?
  releasedAt            DateTime?
  refundedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model Review {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id])
  reviewerId  String
  reviewer    User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  revieweeId  String
  reviewee    User     @relation("ReviewsReceived", fields: [revieweeId], references: [id])
  rating      Int      // 1-5
  comment     String?
  createdAt   DateTime @default(now())

  // Each user can review each booking only once
  @@unique([bookingId, reviewerId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  body      String
  data      Json?    // extra payload
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// Audit trail of invitations / transactional messages sent through Twilio (or stubbed in dev).
model OutboundMessage {
  id        String   @id @default(cuid())
  toPhone   String
  channel   String   // WHATSAPP | SMS | STUB
  kind      String   // e.g. PAYER_INVITE
  body      String
  status    String   // SENT | FAILED
  error     String?
  bookingId String?
  createdAt DateTime @default(now())

  @@index([bookingId])
}

// Who did what in the admin area (verifications, disputes, staff changes).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String   // VERIFICATION_APPROVED | VERIFICATION_REJECTED | DISPUTE_REFUND | DISPUTE_RELEASE | STAFF_ADDED | STAFF_REMOVED
  targetType String
  targetId   String
  note       String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
